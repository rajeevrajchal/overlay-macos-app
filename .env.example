# Copy to `.env` and fill in. `.env` is git-ignored — never commit it.

# --- Figma OAuth (see README "Figma OAuth Setup") ---
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=overlay-viewer://oauth-callback

# --- Release (see RELEASE.md) ---
# The free/ad-hoc release flow needs no signing certificate or password, so
# there are no secrets here. Optionally override the version:
# VERSION=1.0.0
